/* * PROYECTO: Análisis de Subsidios de Vivienda (MongoDB)
 * BASE DE DATOS: BD_John
 * COLECCIÓN: Subsidios_2025
 * DESCRIPCIÓN: Script integral para limpieza (ETL), análisis y estandarización.
 * CREADO POR: John Alexander Casallas
 */

// ==========================================
// 0. CONFIGURACIÓN INICIAL
// ==========================================
use BD_John

// ==========================================
// 1. LIMPIEZA DE DATOS (ETL)
// ==========================================
// Eliminación de comas y conversión de tipos (String -> Int/Long)
// Este paso es fundamental para poder realizar sumas y comparaciones numéricas.

db.Subsidios_2025.updateMany(
  {}, // 1. Filtro vacío: Aplica para todos los documentos
  [
    {
      $set: { // 2. Etapa de modificación
        "Código Municipio": {
          $toInt: { // 4. Convertir a Entero
            $replaceAll: { // 3. Reemplazar comas
              input: "$Código Municipio",
              find: ",",
              replacement: ""
            }
          }
        },
        "Año de asignacion": {
          $toInt: {
            $replaceAll: {
              input: "$Año de asignacion",
              find: ",",
              replacement: ""
            }
          }
        },
        "Valor Asignado": {
          $toLong: { // 5. Convertir a Entero Largo (para cifras grandes)
            $replaceAll: {
              input: "$Valor Asignado",
              find: ",",
              replacement: ""
            }
          }
        }
      }
    }
  ]
);

// ==========================================
// 2. CONSULTAS DE NEGOCIO (Queries)
// ==========================================

// Consulta: Seleccionar departamento "BOYACA" con Año de asignación 2025
print("--- Consulta: Boyacá 2025 ---");
db.Subsidios_2025.find({
  "Departamento": "BOYACA",
  "Año de asignacion": 2025
}).pretty();

// Consulta: Subsidios en "ANTIOQUIA" mayores a 10,000 millones
// (Nota: Se usa el número entero sin comillas gracias a la limpieza del paso 1)
print("--- Consulta: Antioquia > 10.000 Millones ---");
db.Subsidios_2025.find({
  "Departamento": "ANTIOQUIA",
  "Valor Asignado": { $gt: 10000000000 } 
});

// ==========================================
// 3. ANÁLISIS ESTADÍSTICO (Agregaciones)
// ==========================================

// Agregación: Conteo de subsidios por año
print("--- Agregación: Conteo por Año ---");
db.Subsidios_2025.aggregate([
  {
    $group: {
      _id: "$Año de asignacion",
      total: { $sum: 1 }
    }
  },
  { $sort: { _id: 1 } }
]);

// Agregación: Top 5 Departamentos con mayor inversión total
print("--- Agregación: Top 5 Departamentos ---");
db.Subsidios_2025.aggregate([
    {
        $group: {
            _id: "$Departamento",
            total_valor: { $sum: "$Valor Asignado" }
        }
    },
    { $sort: { total_valor: -1 } },
    { $limit: 5 }
]);

// Agregación: Promedio de valor asignado por año
print("--- Agregación: Promedio por Año ---");
db.Subsidios_2025.aggregate([
    {
        $group: {
            _id: "$Año de asignacion",
            promedio_valor: { $avg: "$Valor Asignado" }
        }
    },
    { $sort: { _id: 1 } }
]);

// ==========================================
// 4. MANTENIMIENTO Y CORRECCIONES
// ==========================================
// Eliminar un campo creado por error en un registro específico (si aplica)
db.Subsidios_2025.updateOne(
    { "codigo_municipio": 5004 }, 
    { $unset: { "valor_asignado": "" } }
);

// ==========================================
// 5. ESTANDARIZACIÓN DE ESQUEMA (Renombrado Final)
// ==========================================
// Convertir los nombres de columnas originales a 'snake_case' 
// para finalizar el diseño de la base de datos.

db.Subsidios_2025.updateMany(
  {}, 
  {
    $rename: {
      "Departamento": "departamento",
      "Código Departamento": "codigo_departamento",
      "Municipio": "municipio",
      "Código Municipio": "codigo_municipio",
      "Programa": "programa",
      "Año de asignacion": "anio_asignacion",
      "No. SFV Asignados": "no_sfv_asignados",
      "Valor Asignado": "valor_asignado",
      "Tipo de suelo": "tipo_suelo"
    }
  }
);

print("Script ejecutado exitosamente.");
