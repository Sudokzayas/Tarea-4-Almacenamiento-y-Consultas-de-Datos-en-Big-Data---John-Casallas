/* * PROYECTO: Gestión y Análisis de Subsidios de Vivienda (MongoDB)
 * BASE DE DATOS: BD_John
 * COLECCIÓN: Subsidios_2025
 * Diseñado por: John Casallas - UNAD 2025
 * DESCRIPCIÓN: Script completo que cubre Importación, CRUD, Limpieza y Análisis.
 */

// =========================================================
// PASO 0: IMPORTACIÓN DE DATOS (Ejecutar en Terminal)
// =========================================================
/* MongoDB no importa CSVs desde este script de consola. 
   Debes ejecutar el siguiente comando en tu terminal de sistema (CMD/Bash)
   antes de usar este script:

   mongoimport --db BD_John --collection Subsidios_2025 --type csv --headerline --file "Subsidios_Mejoramientos_Programas_CMC-MCY_20251122.csv"
*/

// =========================================================
// INICIO DEL SCRIPT MONGODB
// =========================================================
use BD_John

// =========================================================
// PASO 1: LIMPIEZA DE DATOS (ETL) - CRÍTICO
// =========================================================
// Eliminamos comas y convertimos texto a números para poder operar.
// Se ejecuta antes de cualquier consulta para asegurar la integridad de datos.

db.Subsidios_2025.updateMany(
  {}, // Filtro vacío: Aplica a toda la colección
  [
    {
      $set: {
        "Código Municipio": {
          $toInt: { 
            $replaceAll: { input: "$Código Municipio", find: ",", replacement: "" }
          }
        },
        "Año de asignacion": {
          $toInt: {
            $replaceAll: { input: "$Año de asignacion", find: ",", replacement: "" }
          }
        },
        "Valor Asignado": {
          $toLong: { 
            $replaceAll: { input: "$Valor Asignado", find: ",", replacement: "" }
          }
        }
      }
    }
  ]
);
print("Limpieza de datos completada.");

// =========================================================
// PASO 2: OPERACIONES CRUD BÁSICAS (Gestión de Registros)
// =========================================================

// A. INSERTAR (Crear un nuevo registro de prueba)
print("--- Insertando registro de prueba ---");
db.Subsidios_2025.insertOne({
    "Departamento": "CUNDINAMARCA",
    "Código Departamento": 25,
    "Municipio": "BOGOTA",
    "Código Municipio": 11001,
    "Programa": "Mi Casa Ya",
    "Año de asignacion": 2025,
    "No. SFV Asignados": "1",
    "Valor Asignado": 50000000, // Valor numérico limpio
    "Tipo de suelo": "URBANO",
    "Es_Prueba": true // Marcador para identificarlo fácilmente
});

// B. CONSULTAR (Leer el registro específico creado)
print("--- Consultando registro creado ---");
db.Subsidios_2025.find({ "Código Municipio": 11001, "Año de asignacion": 2025 }).pretty();

// C. ACTUALIZAR (Modificar el valor del subsidio de prueba)
print("--- Actualizando registro ---");
db.Subsidios_2025.updateOne(
    { "Código Municipio": 11001, "Es_Prueba": true },
    { $set: { "Valor Asignado": 60000000 } }
);

// D. ELIMINAR (Borrar el registro de prueba)
print("--- Eliminando registro de prueba ---");
db.Subsidios_2025.deleteOne({ "Código Municipio": 11001, "Es_Prueba": true });


// =========================================================
// PASO 3: CONSULTAS DE NEGOCIO AVANZADAS
// =========================================================

// 3.1 Consulta: Departamento "BOYACA" año 2025
print("--- Consulta: Boyacá 2025 ---");
db.Subsidios_2025.find({
  "Departamento": "BOYACA",
  "Año de asignacion": 2025
}).pretty();

// 3.2 Consulta: Subsidios en "ANTIOQUIA" mayores a 10,000 millones
print("--- Consulta: Antioquia > 10 mil millones ---");
db.Subsidios_2025.find({
  "Departamento": "ANTIOQUIA",
  "Valor Asignado": { $gt: 10000000000 } 
});

// =========================================================
// PASO 4: ANÁLISIS ESTADÍSTICO (AGREGACIONES)
// =========================================================

// 4.1 Conteo de subsidios por año
print("--- Estadística: Total subsidios por año ---");
db.Subsidios_2025.aggregate([
  {
    $group: {
      _id: "$Año de asignacion",
      total: { $sum: 1 }
    }
  },
  { $sort: { _id: 1 } }
]);

// 4.2 Top 5 Departamentos con mayor inversión
print("--- Estadística: Top 5 Departamentos por Valor ---");
db.Subsidios_2025.aggregate([
    {
        $group: {
            _id: "$Departamento",
            total_valor: { $sum: "$Valor Asignado" }
        }
    },
    { $sort: { total_valor: -1 } },
    { $limit: 5 }
]);

// 4.3 Promedio de valor asignado por año
print("--- Estadística: Promedio Valor por Año ---");
db.Subsidios_2025.aggregate([
    {
        $group: {
            _id: "$Año de asignacion",
            promedio_valor: { $avg: "$Valor Asignado" }
        }
    },
    { $sort: { _id: 1 } }
]);

// =========================================================
// PASO 5: MANTENIMIENTO Y ESTANDARIZACIÓN FINAL
// =========================================================

// Corrección de errores puntuales (si hubiere campos errados creados anteriormente)
db.Subsidios_2025.updateMany({}, { $unset: { "valor_asignado_erroneo": "" } });

// Renombrar campos a 'snake_case' para finalizar el diseño
db.Subsidios_2025.updateMany(
  {}, 
  {
    $rename: {
      "Departamento": "departamento",
      "Código Departamento": "codigo_departamento",
      "Municipio": "municipio",
      "Código Municipio": "codigo_municipio",
      "Programa": "programa",
      "Año de asignacion": "anio_asignacion",
      "No. SFV Asignados": "no_sfv_asignados",
      "Valor Asignado": "valor_asignado",
      "Tipo de suelo": "tipo_suelo"
    }
  }
);

print("Script finalizado exitosamente. BD lista.");
